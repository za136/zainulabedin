    { "id": "c2", "title": { "de": "Austauschbare Details", "en": "Replaceable details" }, "narration": { "de": "Datenbank und UI sind Details am Rand und lassen sich austauschen.", "en": "Database and UI are details on the edge and can be replaced." }, "focus": ["db", "web", "frameworks"] }
