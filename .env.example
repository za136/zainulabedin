# ---------- which store to run (folder under ./stores) ----------
STORE=wissenswerk
# STORE_DIR=/absolute/path/to/a/store   # alternative to STORE

# ---------- API ----------
# Zero-setup dev uses embedded Postgres (PGlite) in ./apps/api/.data/<store>
# DATABASE_URL=postgres://factory:factory@localhost:5432/factory
APP_SECRET=change-me-to-64-random-chars
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
VAT_VALIDATION=format            # use "vies" in production
STORAGE_DIR=./storage            # digital files (e-books, downloads)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Web ----------
# server-side URL of the API (inside Docker: http://api:4000)
# API_URL=http://localhost:4000

# ---------- Factory ----------
# CANVA_ACCESS_TOKEN=...          # for `pnpm factory canva:pull <store>`
