{
  "name": "store-factory",
  "private": true,
  "version": "0.1.0",
  "description": "E-Commerce Store Factory — German-first, multi-vertical commerce platform template (books, digital goods, subscriptions, courses, services, electronics).",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @factory/api --filter @factory/web dev",
    "dev:api": "pnpm --filter @factory/api dev",
    "dev:web": "pnpm --filter @factory/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @factory/db generate",
    "db:migrate": "pnpm --filter @factory/db migrate",
    "db:seed": "pnpm --filter @factory/db seed",
    "factory": "tsx tools/factory/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  }
}
