# ZAIN LABS API. Copy to .env and adjust. Nothing here is required for local development.
ZL_DATABASE_URL=sqlite:///./data/zainlabs.db
ZL_CONTENT_FILE=../content/content.json
# Comma-separated browser origins allowed to call the API (website dev, Expo web dev)
ZL_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Public URLs used in emails and redirects
ZL_SITE_URL=http://localhost:3000
ZL_API_URL=http://localhost:8100
# Admin endpoints are disabled (503) until a token is set. Use a long random string.
# ZL_ADMIN_TOKEN=
# Mail: outbox (writes .eml files, sends nothing) | smtp
ZL_MAIL_BACKEND=outbox
ZL_OUTBOX_DIR=./data/outbox
ZL_MAIL_FROM=hello@zainlabs.example
# ZL_OWNER_EMAIL=           # receives a notification for each new lead
# ZL_SMTP_HOST= ZL_SMTP_PORT=587 ZL_SMTP_USER= ZL_SMTP_PASSWORD= ZL_SMTP_STARTTLS=1
# ZL_LEAD_WEBHOOK_URL=      # optional: forward each lead (n8n, Slack, CRM)
ZL_RETENTION_DAYS=365       # leads older than this are deleted by `zainlabs-api purge`
ZL_RATE_LIMIT=5/600         # max POSTs per client IP per window (seconds)
