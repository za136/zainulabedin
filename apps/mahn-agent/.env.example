# Copy to .env and adjust. Nothing here is required for the demo.

# Claude drafting agent (optional; without a key the deterministic templates are used)
# ANTHROPIC_API_KEY=sk-ant-...
# MAHN_MODEL=claude-opus-5-5
# MAHN_LLM=auto            # auto | off

# ERP: demo | odoo | erpnext
MAHN_ERP=demo
# ODOO_URL=https://your-odoo.example
# ODOO_DB=
# ODOO_USER=
# ODOO_API_KEY=
# ERPNEXT_URL=https://your-erpnext.example
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=

# Mail: outbox (writes .eml files, sends nothing) | smtp
MAHN_MAIL_BACKEND=outbox

# Creditor details printed in letters
MAHN_COMPANY_NAME=Demo Handels GmbH
MAHN_COMPANY_ADDRESS=Musterstraße 1, 10115 Berlin
MAHN_COMPANY_EMAIL=buchhaltung@demo-handels.example
MAHN_COMPANY_IBAN=DE89 3704 0044 0532 0130 00
MAHN_COMPANY_BIC=COBADEFFXXX

# Policy (days overdue per level, min gap between letters)
# MAHN_L1_DAYS=7
# MAHN_L2_DAYS=21
# MAHN_L3_DAYS=35
# MAHN_MIN_GAP_DAYS=10
# Statutory base rates in % (check Bundesbank / OeNB; they change every January and July)
# MAHN_BASE_RATE_DE=1.27
# MAHN_BASE_RATE_AT=1.53

# Protect UI + API with HTTP basic auth
# MAHN_BASIC_AUTH=admin:change-me
