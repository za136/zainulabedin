{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000" } },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "https://api.staging.example.de", "EXPO_PUBLIC_WEB_URL": "https://staging.example.de" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_API_URL": "https://api.example.de", "EXPO_PUBLIC_WEB_URL": "https://www.example.de" } }
  },
  "submit": { "production": {} }
}
