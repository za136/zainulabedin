{
  "name": "@factory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless commerce API for the store factory (Fastify + Drizzle). OpenAPI docs at /docs.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "openapi": "tsx src/scripts/openapi.ts",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@factory/config": "workspace:*",
    "@factory/core": "workspace:*",
    "@factory/db": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "stripe": "^19.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.12"
  }
}
