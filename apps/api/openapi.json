    "/v1/checkout": {
      "post": {
        "summary": "Place an order (legal consents, stock reservation, payment initiation)",
        "tags": [
          "checkout"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cartId": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "billingAddress": {
                    "type": "object",
                    "properties": {
                      "firstName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "lastName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "company": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "street": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 200
                      },
                      "addressLine2": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "zip": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 12
                      },
                      "city": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "country": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "phone": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "firstName",
                      "lastName",
                      "street",
                      "zip",
                      "city",
                      "country"
                    ]
                  },
                  "shippingAddress": {
                    "type": "object",
                    "properties": {
                      "firstName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "lastName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "company": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "street": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 200
                      },
                      "addressLine2": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "zip": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 12
                      },
                      "city": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "country": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 2
                      },
                      "phone": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "firstName",
                      "lastName",
                      "street",
                      "zip",
                      "city",
                      "country"
                    ]
                  },
                  "customerType": {
                    "default": "b2c",
                    "type": "string",
                    "enum": [
                      "b2c",
                      "b2b"
                    ]
                  },
                  "vatId": {
                    "type": "string"
                  },
                  "consents": {
                    "type": "object",
                    "properties": {
                      "terms": {
                        "type": "boolean"
                      },
                      "digital_waiver": {
                        "type": "boolean"
                      },
                      "service_early_start": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "terms"
                    ]
                  },
                  "paymentProvider": {
                    "type": "string"
                  },
                  "createAccountPassword": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 200
                  }
                },
                "required": [
                  "cartId",
                  "email",
                  "billingAddress",
                  "consents",
                  "paymentProvider"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
