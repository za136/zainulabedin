{
  "openapi": "3.0.3",
  "info": {
    "title": "Wissenswerk — Store Factory API",
    "version": "1.0.0",
    "description": "Headless commerce API. All prices in minor units (cents), gross (incl. VAT). Locale via ?locale=de|en, Accept-Language or X-Locale."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {}
  },
