{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "categories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "de",
                "en",
                "fr",
                "it"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "de",
                "en",
                "fr",
                "it"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "image": {
            "type": "string"
          },
          "position": {
            "default": 0,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "slug",
          "name"
        ]
      }
    },
    "products": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "physical",
              "book",
              "ebook",
              "interactive_book",
              "digital_download",
              "license",
              "subscription",
              "course",
              "service"
            ]
          },
          "status": {
            "default": "active",
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          },
          "featured": {
            "default": false,
            "type": "boolean"
          },
          "categories": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "de",
                "en",
                "fr",
                "it"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "subtitle": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "de",
                "en",
                "fr",
                "it"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "de",
                "en",
                "fr",
                "it"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "taxCategory": {
            "type": "string",
            "enum": [
              "standard",
              "reduced",
              "books",
              "ebooks",
              "digital_services",
              "services",
              "exempt"
            ]
          },
          "priceBound": {
            "type": "boolean"
          },
          "brand": {
            "type": "string"
          },
          "seller": {
            "type": "string"
          },
          "images": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string"
                },
                "alt": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "de",
                      "en",
                      "fr",
                      "it"
                    ]
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "src"
              ]
            }
          },
          "attributes": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "variants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "title": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "de",
                      "en",
                      "fr",
                      "it"
                    ]
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "options": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "prices": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "EUR",
                      "CHF",
                      "USD",
                      "GBP"
                    ]
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "compareAt": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "EUR",
                      "CHF",
                      "USD",
                      "GBP"
                    ]
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "stock": {
                  "description": "omit = not tracked (unlimited)",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "weightGrams": {
                  "default": 0,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unitMeasure": {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "enum": [
                        "g",
                        "kg",
                        "ml",
                        "l",
                        "cm",
                        "m",
                        "m2"
                      ]
                    },
                    "amount": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "unit",
                    "amount"
                  ]
                },
                "billing": {
                  "type": "object",
                  "properties": {
                    "interval": {
                      "type": "string",
                      "enum": [
                        "week",
                        "month",
                        "year"
                      ]
                    },
                    "intervalCount": {
                      "default": 1,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "trialDays": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "interval"
                  ]
                }
              },
              "required": [
                "sku",
                "prices"
              ]
            }
          },
          "slots": {
            "description": "bookable slots for kind=service; relative \"+3d10:00\" or ISO",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startsAt": {
                  "type": "string"
                },
                "durationMinutes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "capacity": {
                  "default": 1,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "startsAt",
                "durationMinutes"
              ]
            }
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "kind",
          "title",
          "description",
          "variants"
        ]
      }
    },
    "coupons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2
          },
          "type": {
            "type": "string",
            "enum": [
              "percent",
              "fixed",
              "free_shipping"
            ]
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "CHF",
              "USD",
              "GBP"
            ]
          },
          "minSubtotal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "appliesToKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "physical",
                "book",
                "ebook",
                "interactive_book",
                "digital_download",
                "license",
                "subscription",
                "course",
                "service"
              ]
            }
          },
          "appliesToCategories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startsAt": {},
          "endsAt": {},
          "usageLimit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "usedCount": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "active": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "type",
          "value"
        ]
      }
    },
    "sellers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "commissionBps": {
            "default": 1500,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "slug",
          "name"
        ]
      }
    }
  }
}
